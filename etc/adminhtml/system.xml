<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="mageos_inlinedocs" translate="label" type="text" sortOrder="900"
                 showInDefault="1" showInWebsite="0" showInStore="0">
            <class>separator-top</class>
            <label>Inline Documentation</label>
            <tab>advanced</tab>
            <resource>MageOS_InlineDocs::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1">
                    <label>Enable Inline Documentation</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Shows a documentation marker next to configuration fields that have a note available. The notes ship with the module; nothing is fetched from an external service.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
