<?xml version="1.0"?>
<!--
/**
 * Wires the inline-docs config type: a Filesystem Reader validates and merges
 * every module's inline_docs.xml against inline_docs.xsd, a Converter flattens it
 * to an id-keyed array, and Data caches the merged result under its own cache id.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MageOS\InlineDocs\Model\Config\Data">
        <arguments>
            <argument name="reader" xsi:type="object">MageOS\InlineDocs\Model\Config\Reader</argument>
            <argument name="cacheId" xsi:type="string">mageos_inline_docs</argument>
        </arguments>
    </type>
    <type name="MageOS\InlineDocs\Model\Config\Reader">
        <arguments>
            <argument name="fileName" xsi:type="string">inline_docs.xml</argument>
            <argument name="converter" xsi:type="object">MageOS\InlineDocs\Model\Config\Converter</argument>
            <argument name="schemaLocator" xsi:type="object">MageOS\InlineDocs\Model\Config\SchemaLocator</argument>
        </arguments>
    </type>
</config>
