{
    "name": "mage-os-lab/module-inline-docs",
    "description": "In-admin documentation for Magento / Mage-OS: a note next to each Stores → Configuration field, served from inside the installation with no external service.",
    "type": "magento2-module",
    "license": "MIT",
    "homepage": "https://github.com/mage-os-lab/module-inline-docs",
    "authors": [
        {
            "name": "Nicolas Peric",
            "homepage": "https://github.com/nicolasperic"
        }
    ],
    "require": {
        "php": ">=8.1",
        "magento/framework": ">=103.0.0",
        "magento/module-backend": ">=102.0.0",
        "magento/module-config": ">=101.2.0"
    },
    "require-dev": {
        "magento/magento-coding-standard": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MageOS\\InlineDocs\\": ""
        }
    }
}
