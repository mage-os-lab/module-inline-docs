<?php
/**
 * Hands the page component its configuration.
 *
 * The config is emitted as a JSON *object literal* inside x-magento-init, not as a
 * JS string, so it must not go through escapeJs(): that escapes the structural
 * braces and quotes too (`{` becomes {), producing something no longer parseable
 * as JSON — and x-magento-init fails silently, so the whole feature simply never
 * initialises with nothing in the console to say why.
 *
 * json_encode with the HEX flags is the correct pairing: it escapes <, >, &, ' and "
 * inside string values so the payload is safe in an HTML script context, while
 * leaving the JSON structure intact.
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \MageOS\InlineDocs\ViewModel\InlineDocs $viewModel
 */
$viewModel = $block->getViewModel();
if (!$viewModel->isEnabled()) {
    return;
}
$config = json_encode(
    [
        'fetchUrl'    => $viewModel->getFetchUrl(),
        'showDocLink' => $viewModel->showDocLink(),
    ],
    JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
);
?>
<script type="text/x-magento-init">
{
    "*": {
        "MageOS_InlineDocs/js/inline-docs": <?= /* @noEscape */ $config ?: '{}' ?>
    }
}
</script>
